rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isNullableString(value) {
      return value == null || value is string;
    }

    function validUser(data) {
      return data.keys().hasOnly([
          'schemaVersion', 'displayName', 'photoURL', 'currentStampCount',
          'badgeCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'displayName', 'photoURL', 'currentStampCount',
          'badgeCount', 'createdAt', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 100
        && isNullableString(data.photoURL)
        && data.currentStampCount is int
        && data.currentStampCount >= 0
        && data.currentStampCount < 5
        && data.badgeCount is int
        && data.badgeCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validStamp(data) {
      return data.keys().hasOnly(['note', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['note', 'createdAt', 'updatedAt'])
        && data.note is string
        && data.note.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validTicket(data) {
      return data.keys().hasOnly([
          'badgeOrdinal', 'status', 'wishId', 'rewardNameSnapshot',
          'createdAt', 'redeemedAt'
        ])
        && data.keys().hasAll([
          'badgeOrdinal', 'status', 'wishId', 'rewardNameSnapshot',
          'createdAt', 'redeemedAt'
        ])
        && data.badgeOrdinal is int
        && data.badgeOrdinal > 0
        && data.status in ['available', 'redeemed']
        && isNullableString(data.wishId)
        && isNullableString(data.rewardNameSnapshot)
        && data.createdAt is timestamp
        && (data.redeemedAt == null || data.redeemedAt is timestamp);
    }

    function validWish(data) {
      return data.keys().hasOnly(['name', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['name', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validStoreItem(data) {
      return data.keys().hasOnly(['name', 'price', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['name', 'price', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.price is int
        && data.price == 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validPurchase(data) {
      return data.keys().hasOnly([
          'storeItemId', 'nameSnapshot', 'price', 'ticketIds', 'purchasedAt'
        ])
        && data.keys().hasAll([
          'storeItemId', 'nameSnapshot', 'price', 'ticketIds', 'purchasedAt'
        ])
        && data.storeItemId is string
        && data.storeItemId.size() > 0
        && data.nameSnapshot is string
        && data.nameSnapshot.size() > 0
        && data.nameSnapshot.size() <= 80
        && data.price is int
        && data.price == 1
        && data.ticketIds is list
        && data.ticketIds.size() == 1
        && data.ticketIds[0] is string
        && data.ticketIds[0].size() > 0
        && data.purchasedAt is timestamp;
    }

    match /users/{uid} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid)
        && validUser(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedInAs(uid)
        && validUser(request.resource.data)
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /stamps/{stampId} {
        allow read: if signedInAs(uid);
        allow create: if signedInAs(uid)
          && validStamp(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if signedInAs(uid)
          && validStamp(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note', 'updatedAt'])
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /tickets/{ticketId} {
        allow read: if signedInAs(uid);
        allow create: if signedInAs(uid)
          && validTicket(request.resource.data)
          && request.resource.data.status == 'available'
          && request.resource.data.wishId == null
          && request.resource.data.rewardNameSnapshot == null
          && request.resource.data.redeemedAt == null
          && request.resource.data.createdAt == request.time;
        allow update: if signedInAs(uid)
          && validTicket(request.resource.data)
          && resource.data.status == 'available'
          && request.resource.data.status == 'redeemed'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'wishId', 'rewardNameSnapshot', 'redeemedAt'])
          && request.resource.data.badgeOrdinal == resource.data.badgeOrdinal
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.redeemedAt == request.time
          && request.resource.data.wishId == null
          && request.resource.data.rewardNameSnapshot == null
          && existsAfter(/databases/$(database)/documents/users/$(uid)/purchases/$(ticketId))
          && getAfter(/databases/$(database)/documents/users/$(uid)/purchases/$(ticketId)).data.ticketIds[0] == ticketId;
        allow delete: if false;
      }

      match /storeItems/{storeItemId} {
        allow read: if signedInAs(uid);
        allow create: if signedInAs(uid)
          && validStoreItem(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if signedInAs(uid)
          && validStoreItem(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
          && request.resource.data.price == resource.data.price
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedInAs(uid);
      }

      match /purchases/{purchaseId} {
        allow read: if signedInAs(uid);
        allow create: if signedInAs(uid)
          && validPurchase(request.resource.data)
          && purchaseId == request.resource.data.ticketIds[0]
          && request.resource.data.purchasedAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(uid)/storeItems/$(request.resource.data.storeItemId))
          && getAfter(/databases/$(database)/documents/users/$(uid)/storeItems/$(request.resource.data.storeItemId)).data.name == request.resource.data.nameSnapshot
          && getAfter(/databases/$(database)/documents/users/$(uid)/storeItems/$(request.resource.data.storeItemId)).data.price == request.resource.data.price
          && get(/databases/$(database)/documents/users/$(uid)/tickets/$(request.resource.data.ticketIds[0])).data.status == 'available'
          && getAfter(/databases/$(database)/documents/users/$(uid)/tickets/$(request.resource.data.ticketIds[0])).data.status == 'redeemed'
          && getAfter(/databases/$(database)/documents/users/$(uid)/tickets/$(request.resource.data.ticketIds[0])).data.wishId == null
          && getAfter(/databases/$(database)/documents/users/$(uid)/tickets/$(request.resource.data.ticketIds[0])).data.rewardNameSnapshot == null
          && getAfter(/databases/$(database)/documents/users/$(uid)/tickets/$(request.resource.data.ticketIds[0])).data.redeemedAt == request.time;
        allow update, delete: if false;
      }

      match /wishes/{wishId} {
        allow read: if signedInAs(uid);
        allow create: if signedInAs(uid)
          && validWish(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if signedInAs(uid)
          && validWish(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedInAs(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
